{
  "name": "omniscripta-ui",
  "version": "1.0.0",
  "description": "Frontend source for Omniscripta: live recording, uploaded-audio transcription, transcript editing, document review, and topic navigation.",
  "main": "index.js",
  "scripts": {
    "build:js": "esbuild js/app.js --bundle --outfile=/tmp/omniscripta-ui-check-app.bundle.js --target=es2020 --log-level=error",
    "build:css": "esbuild css/style.css --bundle --outfile=/tmp/omniscripta-ui-check-style.css --loader:.svg=dataurl --target=es2020 --log-level=error",
    "check": "npm run build:js && npm run build:css",
    "test": "npm run check"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Bobcat/omniscripta-ui.git"
  },
  "keywords": [],
  "author": "",
  "bugs": {
    "url": "https://github.com/Bobcat/omniscripta-ui/issues"
  },
  "homepage": "https://github.com/Bobcat/omniscripta-ui#readme",
  "dependencies": {
    "@spa-foundation/core": "file:../spa-foundation/core"
  },
  "devDependencies": {
    "esbuild": "^0.27.2"
  }
}
